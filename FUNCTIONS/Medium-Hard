Q24. Banking System Using Recursion and Pointers
Create a banking application using multiple functions.
•	Accept an initial account balance.
•	Perform deposits and withdrawals.
•	Update the original balance using pointers.
•	Calculate compound interest using recursion.
•	Display the final balance.
•	Display total deposits, withdrawals, and interest earned.

#include <stdio.h>

// 1. Pointers ka use karke deposit aur original balance update karne ka function
void depositMoney(float *balance, float *totalDeposits) {
    float amount;
    printf("Deposit karne ke liye amount enter karein: Rs. ");
    scanf("%f", &amount);

    if (amount > 0) {
        *balance += amount;
        *totalDeposits += amount;
        printf("Rs. %.2f successfully deposit ho gaye! Updated Balance: Rs. %.2f\n", amount, *balance);
    } else {
        printf("Invalid amount! Positive value enter karein.\n");
    }
}

// 2. Pointers ka use karke withdraw aur original balance update karne ka function
void withdrawMoney(float *balance, float *totalWithdrawals) {
    float amount;
    printf("Withdraw karne ke liye amount enter karein: Rs. ");
    scanf("%f", &amount);

    if (amount > *balance) {
        printf("Insufficient balance! Available Balance: Rs. %.2f\n", *balance);
    } else if (amount <= 0) {
        printf("Invalid amount! Positive value enter karein.\n");
    } else {
        *balance -= amount;
        *totalWithdrawals += amount;
        printf("Rs. %.2f successfully withdraw ho gaye! Updated Balance: Rs. %.2f\n", amount, *balance);
    }
}

// 3. Recursion ka use karke compound amount calculate karne ka function
float calculateCompoundRecursive(float principal, float rate, int years) {
    if (years == 0) {
        return principal;
    }
    float nextYearAmount = principal + (principal * rate / 100.0);
    return calculateCompoundRecursive(nextYearAmount, rate, years - 1);
}

// 4. Interest apply karne aur pointer se original balance update karne ka function
void applyCompoundInterest(float *balance, float *totalInterest) {
    float rate;
    int years;

    printf("Annual Interest Rate (%%) enter karein: ");
    scanf("%f", &rate);
    printf("Kitne saal (years) ke liye interest calculate karna hai? ");
    scanf("%d", &years);

    if (rate < 0 || years <= 0) {
        printf("Invalid rate ya years! Sahi values enter karein.\n");
        return;
    }

    float newBalance = calculateCompoundRecursive(*balance, rate, years);
    float interestEarned = newBalance - (*balance);

    *balance = newBalance;
    *totalInterest += interestEarned;

    printf("%d saal ka Compound Interest: Rs. %.2f\n", years, interestEarned);
    printf("Interest add hone ke baad Updated Balance: Rs. %.2f\n", *balance);
}

// 5. Final balance aur poori summary display karne ka function
void displaySummary(float initialBalance, float finalBalance, float totalDeposits, float totalWithdrawals, float totalInterest) {
    printf("\n=====================================================\n");
    printf("             BANKING TRANSACTION SUMMARY             \n");
    printf("=====================================================\n");
    printf("Initial Balance          : Rs. %.2f\n", initialBalance);
    printf("Total Deposits           : + Rs. %.2f\n", totalDeposits);
    printf("Total Withdrawals        : - Rs. %.2f\n", totalWithdrawals);
    printf("Total Interest Earned    : + Rs. %.2f\n", totalInterest);
    printf("-----------------------------------------------------\n");
    printf("Final Account Balance    : Rs. %.2f\n", finalBalance);
    printf("=====================================================\n");
}

int main() {
    float initialBalance, balance;
    float totalDeposits = 0.0, totalWithdrawals = 0.0, totalInterest = 0.0;
    int choice;

    printf("Initial Account Balance enter karein: Rs. ");
    scanf("%f", &initialBalance);

    if (initialBalance < 0) {
        printf("Invalid balance! Positive value enter karein.\n");
        return 0;
    }

    balance = initialBalance;

    while (1) {
        printf("\n--- BANKING MENU ---\n");
        printf("1. Deposit Money\n");
        printf("2. Withdraw Money\n");
        printf("3. Calculate & Add Compound Interest (Recursive)\n");
        printf("4. Exit & Display Final Summary\n");
        printf("Apni choice enter karein (1-4): ");
        scanf("%d", &choice);

        switch (choice) {
            case 1:
                depositMoney(&balance, &totalDeposits);
                break;
            case 2:
                withdrawMoney(&balance, &totalWithdrawals);
                break;
            case 3:
                applyCompoundInterest(&balance, &totalInterest);
                break;
            case 4:
                displaySummary(initialBalance, balance, totalDeposits, totalWithdrawals, totalInterest);
                return 0;
            default:
                printf("Invalid choice! Kripya 1 se 4 ke beech number chunein.\n");
        }
    }

    return 0;
}

