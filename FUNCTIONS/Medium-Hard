Q2. Shopping Mall Billing System
Create a billing program using functions that calculates:
•	Total price of 5 different products.
•	Discount based on the total amount.
•	GST of 18% after discount.
•	Final payable amount.
•	Average price of products.

#include <stdio.h>

// 5 products ka total price calculate karne ka function
float calculateTotal(float prices[]) {
    float total = 0;
    for (int i = 0; i < 5; i++) {
        total += prices[i];
    }
    return total;
}

// Total amount ke hisab se Discount calculate karne ka function
float calculateDiscount(float total) {
    if (total >= 5000) {
        return 0.10 * total; // 10% discount agar total 5000 ya usse zyada ho
    } else if (total >= 2000) {
        return 0.05 * total; // 5% discount agar total 2000 ya usse zyada ho
    } else {
        return 0.0;          // 2000 se kam par koi discount nahi
    }
}

// Discount ke baad 18% GST calculate karne ka function
float calculateGST(float amountAfterDiscount) {
    return 0.18 * amountAfterDiscount;
}

// Final payable amount calculate karne ka function
float calculateFinalAmount(float amountAfterDiscount, float gst) {
    return amountAfterDiscount + gst;
}

// Products ka average price calculate karne ka function
float calculateAverage(float total) {
    return total / 5.0;
}

// Poora bill display karne ka function
void displayBill(float total, float discount, float gst, float finalAmount, float average) {
    printf("\n====================================\n");
    printf("        SHOPPING MALL BILL          \n");
    printf("====================================\n");
    printf("Total Price (5 Items) : Rs. %.2f\n", total);
    printf("Discount Applied      : Rs. %.2f\n", discount);
    printf("Price After Discount  : Rs. %.2f\n", total - discount);
    printf("GST (18%%)             : Rs. %.2f\n", gst);
    printf("------------------------------------\n");
    printf("Final Payable Amount  : Rs. %.2f\n", finalAmount);
    printf("------------------------------------\n");
    printf("Average Product Price : Rs. %.2f\n", average);
    printf("====================================\n");
}

int main() {
    float prices[5];

    printf("5 products ke prices enter karein:\n");
    for (int i = 0; i < 5; i++) {
        printf("Product %d ka price: Rs. ", i + 1);
        scanf("%f", &prices[i]);
    }

    // Separate functions se calculations
    float total = calculateTotal(prices);
    float discount = calculateDiscount(total);
    float amountAfterDiscount = total - discount;
    float gst = calculateGST(amountAfterDiscount);
    float finalAmount = calculateFinalAmount(amountAfterDiscount, gst);
    float average = calculateAverage(total);

    // Bill display karna
    displayBill(total, discount, gst, finalAmount, average);

    return 0;
}

