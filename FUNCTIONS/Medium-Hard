Use 2D arrays as function parameters.

#include <stdio.h>

// Matrix input lene ka function
void acceptMatrix(int mat[10][10], int rows, int cols, char name) {
    printf("\nMatrix %c (%dx%d) ke elements enter karein:\n", name, rows, cols);
    for (int i = 0; i < rows; i++) {
        for (int j = 0; j < cols; j++) {
            printf("Element [%d][%d]: ", i, j);
            scanf("%d", &mat[i][j]);
        }
    }
}

// Matrix display karne ka function
void displayMatrix(int mat[10][10], int rows, int cols) {
    for (int i = 0; i < rows; i++) {
        for (int j = 0; j < cols; j++) {
            printf("%d\t", mat[i][j]);
        }
        printf("\n");
    }
}

// 1. Matrix Addition ka function
void addMatrices(int a[10][10], int b[10][10], int res[10][10], int rows, int cols) {
    for (int i = 0; i < rows; i++) {
        for (int j = 0; j < cols; j++) {
            res[i][j] = a[i][j] + b[i][j];
        }
    }
    printf("\n--- Matrix Addition Result ---\n");
    displayMatrix(res, rows, cols);
}

// 2. Matrix Subtraction ka function
void subtractMatrices(int a[10][10], int b[10][10], int res[10][10], int rows, int cols) {
    for (int i = 0; i < rows; i++) {
        for (int j = 0; j < cols; j++) {
            res[i][j] = a[i][j] - b[i][j];
        }
    }
    printf("\n--- Matrix Subtraction Result (A - B) ---\n");
    displayMatrix(res, rows, cols);
}

// 3. Matrix Multiplication ka function
void multiplyMatrices(int a[10][10], int b[10][10], int res[10][10], int r1, int c1, int c2) {
    for (int i = 0; i < r1; i++) {
        for (int j = 0; j < c2; j++) {
            res[i][j] = 0;
            for (int k = 0; k < c1; k++) {
                res[i][j] += a[i][k] * b[k][j];
            }
        }
    }
    printf("\n--- Matrix Multiplication Result (A * B) ---\n");
    displayMatrix(res, r1, c2);
}

// 4. Matrix Transpose ka function
void transposeMatrix(int mat[10][10], int trans[10][10], int rows, int cols) {
    for (int i = 0; i < rows; i++) {
        for (int j = 0; j < cols; j++) {
            trans[j][i] = mat[i][j];
        }
    }
    printf("\n--- Transpose of Matrix A ---\n");
    displayMatrix(trans, cols, rows);
}

// 5. Matrix Diagonal Sum ka function (Square matrix ke liye)
void diagonalSum(int mat[10][10], int rows, int cols) {
    if (rows != cols) {
        printf("\nDiagonal sum sirf Square Matrix (rows == cols) ke liye possible hai!\n");
        return;
    }
    int mainDiag = 0, secDiag = 0;
    for (int i = 0; i < rows; i++) {
        mainDiag += mat[i][i];
        secDiag += mat[i][rows - 1 - i];
    }
    printf("\n--- Diagonal Sum of Matrix A ---\n");
    printf("Main Diagonal Sum      : %d\n", mainDiag);
    printf("Secondary Diagonal Sum : %d\n", secDiag);
}

int main() {
    int a[10][10], b[10][10], result[10][10];
    int r1, c1, r2, c2;

    printf("Matrix A ke rows aur columns enter karein (max 10): ");
    scanf("%d %d", &r1, &c1);

    printf("Matrix B ke rows aur columns enter karein (max 10): ");
    scanf("%d %d", &r2, &c2);

    // Dono matrices input lena
    acceptMatrix(a, r1, c1, 'A');
    acceptMatrix(b, r2, c2, 'B');

    printf("\n========================================\n");
    printf("        MATRIX OPERATIONS OUTPUT        \n");
    printf("========================================\n");

    // Addition aur Subtraction check (Dimensions same hone chahiye)
    if (r1 == r2 && c1 == c2) {
        addMatrices(a, b, result, r1, c1);
        subtractMatrices(a, b, result, r1, c1);
    } else {
        printf("\nAddition aur Subtraction possible nahi hai (Dimensions alag hain).\n");
    }

    // Multiplication check (c1 == r2 hona chahiye)
    if (c1 == r2) {
        multiplyMatrices(a, b, result, r1, c1, c2);
    } else {
        printf("\nMultiplication possible nahi hai (Matrix A ke columns != Matrix B ke rows).\n");
    }

    // Matrix A ka Transpose aur Diagonal Sum
    transposeMatrix(a, result, r1, c1);
    diagonalSum(a, r1, c1);

    printf("========================================\n");

    return 0;
}
