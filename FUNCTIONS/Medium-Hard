Q5. Electricity Bill Calculator
Write a C program using multiple functions to calculate an electricity bill.
•	First 100 units: ₹2 per unit.
•	Next 100 units: ₹3 per unit.
•	Above 200 units: ₹5 per unit.
•	Add a fixed meter charge of ₹150.
•	Add 5% tax to the bill.
Display the complete bill.

#include <stdio.h>

// Units ke hisab se basic bill calculate karne ka function
float calculateUnitCharge(int units) {
    float charge = 0;
    if (units <= 100) {
        charge = units * 2.0;
    } else if (units <= 200) {
        charge = (100 * 2.0) + ((units - 100) * 3.0);
    } else {
        charge = (100 * 2.0) + (100 * 3.0) + ((units - 200) * 5.0);
    }
    return charge;
}

// Fixed meter charge (Rs. 150) add karne ka function
float addMeterCharge(float unitCharge) {
    return unitCharge + 150.0;
}

// 5% tax calculate karne ka function
float calculateTax(float subTotal) {
    return 0.05 * subTotal;
}

// Final payable bill calculate karne ka function
float calculateFinalBill(float subTotal, float tax) {
    return subTotal + tax;
}

// Complete electricity bill display karne ka function
void displayBill(int units, float unitCharge, float subTotal, float tax, float finalBill) {
    printf("\n====================================\n");
    printf("          ELECTRICITY BILL          \n");
    printf("====================================\n");
    printf("Total Units Consumed : %d units\n", units);
    printf("Unit Charges         : Rs. %.2f\n", unitCharge);
    printf("Fixed Meter Charge   : Rs. 150.00\n");
    printf("------------------------------------\n");
    printf("Sub-Total            : Rs. %.2f\n", subTotal);
    printf("Tax (5%%)             : Rs. %.2f\n", tax);
    printf("------------------------------------\n");
    printf("Final Payable Bill   : Rs. %.2f\n", finalBill);
    printf("====================================\n");
}

int main() {
    int units;

    printf("Total consumed electricity units enter karein: ");
    scanf("%d", &units);

    if (units < 0) {
        printf("Invalid units! Negative value allowed nahi hai.\n");
        return 0;
    }

    // Separate functions se calculations
    float unitCharge = calculateUnitCharge(units);
    float subTotal = addMeterCharge(unitCharge);
    float tax = calculateTax(subTotal);
    float finalBill = calculateFinalBill(subTotal, tax);

    // Complete bill display karna
    displayBill(units, unitCharge, subTotal, tax, finalBill);

    return 0;
}
