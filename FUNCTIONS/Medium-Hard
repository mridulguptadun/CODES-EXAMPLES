    printf("----------------------------------------\n");
}

// 4. Paise deposit karne ka function
float depositMoney(float balance, char history[], int *count) {
    float amount;
    printf("Deposit karne ke liye amount enter karein: Rs. ");
    scanf("%f", &amount);

    if (amount > 0) {
        balance += amount;
        recordTransaction(history, count, "DEPOSIT", amount, 0.0);
        printf("Rs. %.2f successfully deposit ho gaye! New Balance: Rs. %.2f\n", amount, balance);
    } else {
        printf("Invalid amount! Positive value enter karein.\n");
    }
    return balance;
}

// 5. Paise withdraw karne ka function
float withdrawMoney(float balance, char history[], int *count) {
    float amount;
    printf("Withdraw karne ke liye amount enter karein: Rs. ");
    scanf("%f", &amount);

    if (amount <= 0) {
        printf("Invalid amount! Positive value enter karein.\n");
        return balance;
    }

    float charge = calculateTransactionCharge(amount);
    float totalDeduction = amount + charge;

    if (totalDeduction > balance) {
        printf("Insufficient balance! (Required: Rs. %.2f including Rs. %.2f charge)\n", totalDeduction, charge);
    } else {
        balance -= totalDeduction;
        recordTransaction(history, count, "WITHDRAW", amount, charge);
        printf("Rs. %.2f withdraw ho gaye! (Transaction Charge: Rs. %.2f)\n", amount, charge);
        printf("Remaining Balance: Rs. %.2f\n", balance);
    }
    return balance;
}

// 6. Doosre account mein paise transfer karne ka function
void transferMoney(float *senderBalance, float *receiverBalance, char history[], int *count) {
    float amount;
    printf("Receiver Account (Acc #2) mein transfer karne ke liye amount enter karein: Rs. ");
    scanf("%f", &amount);

    if (amount <= 0) {
        printf("Invalid amount! Positive value enter karein.\n");
        return;
    }

    float charge = calculateTransactionCharge(amount);
    float totalDeduction = amount + charge;

    if (totalDeduction > *senderBalance) {
        printf("Transfer Failed! Insufficient balance (Required: Rs. %.2f including Rs. %.2f charge)\n", totalDeduction, charge);
    } else {
        *senderBalance -= totalDeduction;
        *receiverBalance += amount;
        recordTransaction(history, count, "TRANSFER", amount, charge);
        printf("Rs. %.2f successfully Account #2 mein transfer ho gaye!\n", amount);
        printf("Transaction Charge: Rs. %.2f | Your New Balance: Rs. %.2f\n", charge, *senderBalance);
        printf("Account #2 New Balance: Rs. %.2f\n", *receiverBalance);
    }
}

// 7. Transaction history display karne ka function
void displayTransactionHistory(char history[], int count) {
