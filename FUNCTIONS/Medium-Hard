Q4. Bank Account Management System
Create a banking program using functions to perform:
•	Deposit money.
•	Withdraw money.
•	Calculate interest.
•	Display current balance.

#include <stdio.h>

// Paise deposit karne ka function
float depositMoney(float balance) {
    float amount;
    printf("Deposit karne ke liye amount enter karein: Rs. ");
    scanf("%f", &amount);

    if (amount > 0) {
        balance += amount;
        printf("Rs. %.2f successfully deposit ho gaye!\n", amount);
    } else {
        printf("Invalid amount! Positive value enter karein.\n");
    }
    return balance;
}

// Paise withdraw karne ka function
float withdrawMoney(float balance) {
    float amount;
    printf("Withdraw karne ke liye amount enter karein: Rs. ");
    scanf("%f", &amount);

    if (amount > balance) {
        printf("Insufficient balance! Aapke account mein sirf Rs. %.2f hain.\n", balance);
    } else if (amount <= 0) {
        printf("Invalid amount! Positive value enter karein.\n");
    } else {
        balance -= amount;
        printf("Rs. %.2f successfully withdraw ho gaye!\n", amount);
    }
    return balance;
}

// Interest calculate karne ka function (4% per annum)
void calculateInterest(float balance) {
    float rate = 4.0; // 4% annual interest rate
    float years;
    printf("Kitne saal (years) ke liye interest calculate karna hai? ");
    scanf("%f", &years);

    if (years > 0) {
        float interest = (balance * rate * years) / 100.0;
        printf("%.1f saal ka Interest (at %.1f%% rate) : Rs. %.2f\n", years, rate, interest);
        printf("Interest ke baad Total Balance          : Rs. %.2f\n", balance + interest);
    } else {
        printf("Invalid time! Saal 0 se zyada hona chahiye.\n");
    }
}

// Current balance display karne ka function
void displayBalance(float balance) {
    printf("\n====================================\n");
    printf("Current Account Balance : Rs. %.2f\n", balance);
    printf("====================================\n");
}

int main() {
    float balance = 10000.0; // Initial default balance Rs. 10,000
    int choice;

    printf("====================================\n");
    printf("   BANK ACCOUNT MANAGEMENT SYSTEM   \n");
    printf("====================================\n");
    printf("Initial Balance: Rs. %.2f\n", balance);

    while (1) {
        printf("\n--- MENU ---\n");
        printf("1. Deposit Money\n");
        printf("2. Withdraw Money\n");
        printf("3. Calculate Interest\n");
        printf("4. Display Current Balance\n");
        printf("5. Exit\n");
        printf("Apni choice enter karein (1-5): ");
        scanf("%d", &choice);

        switch (choice) {
            case 1:
                balance = depositMoney(balance);
                break;
            case 2:
                balance = withdrawMoney(balance);
                break;
            case 3:
                calculateInterest(balance);
                break;
            case 4:
                displayBalance(balance);
                break;
            case 5:
                printf("Thank you for banking with us!\n");
                return 0;
            default:
                printf("Invalid choice! Kripya 1 se 5 ke beech number chunein.\n");
        }
    }

    return 0;
}
