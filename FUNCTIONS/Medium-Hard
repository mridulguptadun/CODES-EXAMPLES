Q22. Hospital Management and Patient Report
Create a hospital management program using functions.
•	Store records of 10 patients.
•	Calculate each patient's total medical expenses.
•	Apply insurance coverage.
•	Calculate the remaining payable amount.
•	Find the patient with the highest bill.
•	Calculate the average hospital expense.
•	Display a complete patient report.

#include <stdio.h>

// 1. 10 patients ke records input lene ka function
void storePatientRecords(int ids[], char names[], float roomCharges[], float doctorFees[], float medicineCosts[], int hasInsurance[]) {
    printf("10 patients ke records enter karein:\n");
    for (int i = 0; i < 10; i++) {
        printf("\n--- Patient %d ---\n", i + 1);
        printf("Patient ID: ");
        scanf("%d", &ids[i]);
        printf("Patient Name (bina space ke, e.g., Neha_Singh): ");
        scanf("%s", names[i]);
        printf("Room Charges: Rs. ");
        scanf("%f", &roomCharges[i]);
        printf("Doctor Fees: Rs. ");
        scanf("%f", &doctorFees[i]);
        printf("Medicine Costs: Rs. ");
        scanf("%f", &medicineCosts[i]);
        printf("Kya Insurance hai? (1 for Yes, 0 for No): ");
        scanf("%d", &hasInsurance[i]);
    }
}

// 2. Har patient ka total medical expense calculate karne ka function
void calculateTotalExpenses(float roomCharges[], float doctorFees[], float medicineCosts[], float totalExpenses[]) {
    for (int i = 0; i < 10; i++) {
        totalExpenses[i] = roomCharges[i] + doctorFees[i] + medicineCosts[i];
    }
}

// 3. Insurance coverage calculate karne ka function (60% coverage agar insurance hai)
void applyInsuranceCoverage(float totalExpenses[], int hasInsurance[], float insuranceCovered[]) {
    for (int i = 0; i < 10; i++) {
        if (hasInsurance[i] == 1) {
            insuranceCovered[i] = 0.60 * totalExpenses[i]; // 60% insurance coverage
        } else {
            insuranceCovered[i] = 0.0;
        }
    }
}

// 4. Remaining payable amount calculate karne ka function
void calculatePayableAmount(float totalExpenses[], float insuranceCovered[], float payableAmount[]) {
    for (int i = 0; i < 10; i++) {
        payableAmount[i] = totalExpenses[i] - insuranceCovered[i];
    }
}

// 5. Highest bill wale patient ko find aur display karne ka function
void findHighestBillPatient(int ids[], char names[], float totalExpenses[]) {
    int maxIndex = 0;
    for (int i = 1; i < 10; i++) {
        if (totalExpenses[i] > totalExpenses[maxIndex]) {
            maxIndex = i;
        }
    }
    printf("Highest Bill Patient  : %s (ID: %d) - Total Expense: Rs. %.2f\n", names[maxIndex], ids[maxIndex], totalExpenses[maxIndex]);
}

// 6. Average hospital expense calculate karne ka function
float calculateAverageExpense(float totalExpenses[]) {
    float sum = 0.0;
    for (int i = 0; i < 10; i++) {
        sum += totalExpenses[i];
    }
    return sum / 10.0;
}

// 7. Complete patient report display karne ka function
void displayPatientReport(int ids[], char names[], float totalExpenses[], float insuranceCovered[], float payableAmount[], float averageExpense) {
    printf("\n=================================================================================\n");
    printf("                        HOSPITAL PATIENT BILLING REPORT                          \n");
    printf("=================================================================================\n");
    printf("ID\tPatient Name\t\tTotal Expense\tInsurance\tPayable Amount\n");
    printf("---------------------------------------------------------------------------------\n");
    for (int i = 0; i < 10; i++) {
        printf("%d\t%-15s\t\tRs. %.2f\tRs. %.2f\tRs. %.2f\n", ids[i], names[i], totalExpenses[i], insuranceCovered[i], payableAmount[i]);
    }
    printf("---------------------------------------------------------------------------------\n");
    printf("Average Hospital Expense : Rs. %.2f\n", averageExpense);
    findHighestBillPatient(ids, names, totalExpenses);
    printf("=================================================================================\n");
}

int main() {
    int ids[10], hasInsurance[10];
    char names[10][50];
    float roomCharges[10], doctorFees[10], medicineCosts[10];
    float totalExpenses[10], insuranceCovered[10], payableAmount[10];

    // 10 patients ka data input lena
    storePatientRecords(ids, names, roomCharges, doctorFees, medicineCosts, hasInsurance);

    // Separate functions se calculations
    calculateTotalExpenses(roomCharges, doctorFees, medicineCosts, totalExpenses);
    applyInsuranceCoverage(totalExpenses, hasInsurance, insuranceCovered);
    calculatePayableAmount(totalExpenses, insuranceCovered, payableAmount);
    float averageExpense = calculateAverageExpense(totalExpenses);

    // Complete patient report display karna
    displayPatientReport(ids, names, totalExpenses, insuranceCovered, payableAmount, averageExpense);

    return 0;
}
