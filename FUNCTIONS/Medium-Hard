Q8. Temperature Conversion System
Create a menu-driven program using functions to convert:
•	Celsius to Fahrenheit.
•	Fahrenheit to Celsius.
•	Celsius to Kelvin.
•	Kelvin to Celsius.
Also create a function to classify the temperature as Cold, Normal, or Hot.

#include <stdio.h>

// Celsius ko Fahrenheit mein convert karne ka function
float celsiusToFahrenheit(float c) {
    return (c * 9.0 / 5.0) + 32.0;
}

// Fahrenheit ko Celsius mein convert karne ka function
float fahrenheitToCelsius(float f) {
    return (f - 32.0) * 5.0 / 9.0;
}

// Celsius ko Kelvin mein convert karne ka function
float celsiusToKelvin(float c) {
    return c + 273.15;
}

// Kelvin ko Celsius mein convert karne ka function
float kelvinToCelsius(float k) {
    return k - 273.15;
}

// Temperature ko Cold, Normal, ya Hot classify karne ka function (Celsius ke base par)
void classifyTemperature(float celsius) {
    printf("Temperature Status : ");
    if (celsius < 15.0) {
        printf("COLD\n");
    } else if (celsius <= 30.0) {
        printf("NORMAL\n");
    } else {
        printf("HOT\n");
    }
}

int main() {
    int choice;
    float temp, converted, tempInCelsius;

    while (1) {
        printf("\n====================================\n");
        printf("   TEMPERATURE CONVERSION SYSTEM    \n");
        printf("====================================\n");
        printf("1. Celsius to Fahrenheit\n");
        printf("2. Fahrenheit to Celsius\n");
        printf("3. Celsius to Kelvin\n");
        printf("4. Kelvin to Celsius\n");
        printf("5. Exit\n");
        printf("Apni choice enter karein (1-5): ");
        scanf("%d", &choice);

        if (choice == 5) {
            printf("Program exit ho raha hai. Thank you!\n");
            break;
        }

        if (choice < 1 || choice > 5) {
            printf("Invalid choice! Kripya 1 se 5 ke beech number chunein.\n");
            continue;
        }

        printf("Temperature enter karein: ");
        scanf("%f", &temp);

        printf("------------------------------------\n");
        switch (choice) {
            case 1:
                converted = celsiusToFahrenheit(temp);
                tempInCelsius = temp;
                printf("%.2f Celsius = %.2f Fahrenheit\n", temp, converted);
                break;
            case 2:
                converted = fahrenheitToCelsius(temp);
                tempInCelsius = converted;
                printf("%.2f Fahrenheit = %.2f Celsius\n", temp, converted);
                break;
            case 3:
                converted = celsiusToKelvin(temp);
                tempInCelsius = temp;
                printf("%.2f Celsius = %.2f Kelvin\n", temp, converted);
                break;
            case 4:
                converted = kelvinToCelsius(temp);
                tempInCelsius = converted;
                printf("%.2f Kelvin = %.2f Celsius\n", temp, converted);
                break;
        }

        // Har conversion ke baad temperature ka status (Cold/Normal/Hot) dikhana
        classifyTemperature(tempInCelsius);
        printf("------------------------------------\n");
    }

    return 0;
}
