Q1. Employee Salary Management System
Write a C program using separate functions to calculate an employee's gross salary, deductions, tax, and final net salary.
•	Basic Salary = ₹45,000
•	HRA = 20% of Basic Salary
•	DA = 10% of Basic Salary
•	PF = 12% of Basic Salary
•	Income Tax = 5% of Gross Salary
Display all salary details using separate functions.

#include <stdio.h>

// Gross Salary calculate karne ka function
float calculateGrossSalary(float basic) {
    float hra = 0.20 * basic; // 20% of Basic
    float da = 0.10 * basic;  // 10% of Basic
    return basic + hra + da;
}

// PF Deduction calculate karne ka function
float calculatePF(float basic) {
    return 0.12 * basic; // 12% of Basic
}

// Income Tax calculate karne ka function
float calculateTax(float gross) {
    return 0.05 * gross; // 5% of Gross
}

// Final Net Salary calculate karne ka function
float calculateNetSalary(float gross, float pf, float tax) {
    float totalDeductions = pf + tax;
    return gross - totalDeductions;
}

// Saari salary details display karne ka function
void displaySalaryDetails(float basic, float hra, float da, float gross, float pf, float tax, float net) {
    printf("====================================\n");
    printf("       EMPLOYEE SALARY SLIP         \n");
    printf("====================================\n");
    printf("Basic Salary       : Rs. %.2f\n", basic);
    printf("HRA (20%%)          : Rs. %.2f\n", hra);
    printf("DA (10%%)           : Rs. %.2f\n", da);
    printf("------------------------------------\n");
    printf("Gross Salary       : Rs. %.2f\n", gross);
    printf("------------------------------------\n");
    printf("PF Deduction (12%%) : Rs. %.2f\n", pf);
    printf("Income Tax (5%%)    : Rs. %.2f\n", tax);
    printf("Total Deductions   : Rs. %.2f\n", pf + tax);
    printf("------------------------------------\n");
    printf("Final Net Salary   : Rs. %.2f\n", net);
    printf("====================================\n");
}

int main() {
    float basicSalary = 45000.0;
    float hra = 0.20 * basicSalary;
    float da = 0.10 * basicSalary;

    // Separate functions se calculations
    float grossSalary = calculateGrossSalary(basicSalary);
    float pf = calculatePF(basicSalary);
    float tax = calculateTax(grossSalary);
    float netSalary = calculateNetSalary(grossSalary, pf, tax);

    // Separate function se display
    displaySalaryDetails(basicSalary, hra, da, grossSalary, pf, tax, netSalary);

    return 0;
}
