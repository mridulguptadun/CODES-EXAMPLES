Q14. Recursive Number Calculator
Write a program using recursive functions to calculate:
•	Factorial of a number.
•	Sum of digits.
•	Power of a number.
•	Fibonacci series.
•	Greatest Common Divisor (GCD).

#include <stdio.h>

// 1. Factorial calculate karne ka recursive function
long long factorial(int n) {
    if (n <= 1) {
        return 1;
    }
    return n * factorial(n - 1);
}

// 2. Sum of digits calculate karne ka recursive function
int sumOfDigits(int n) {
    if (n == 0) {
        return 0;
    }
    return (n % 10) + sumOfDigits(n / 10);
}

// 3. Power (base^exp) calculate karne ka recursive function
long long power(int base, int exp) {
    if (exp == 0) {
        return 1;
    }
    return base * power(base, exp - 1);
}

// 4. Fibonacci series ka nth term nikalne ka recursive function
int fibonacci(int n) {
    if (n == 0) {
        return 0;
    }
    if (n == 1) {
        return 1;
    }
    return fibonacci(n - 1) + fibonacci(n - 2);
}

// 5. Greatest Common Divisor (GCD) nikalne ka recursive function
int gcd(int a, int b) {
    if (b == 0) {
        return a;
    }
    return gcd(b, a % b);
}

int main() {
    int choice, num, base, exp, terms, num1, num2;

    while (1) {
        printf("\n========================================\n");
        printf("      RECURSIVE NUMBER CALCULATOR       \n");
        printf("========================================\n");
        printf("1. Factorial of a number\n");
        printf("2. Sum of digits\n");
        printf("3. Power of a number\n");
        printf("4. Fibonacci series\n");
        printf("5. Greatest Common Divisor (GCD)\n");
        printf("6. Exit\n");
        printf("Apni choice enter karein (1-6): ");
        scanf("%d", &choice);

        if (choice == 6) {
            printf("Program exit ho raha hai. Thank you!\n");
            break;
        }

        printf("----------------------------------------\n");
        switch (choice) {
            case 1:
                printf("Number enter karein (non-negative): ");
                scanf("%d", &num);
                if (num < 0) {
                    printf("Negative number ka factorial nahi hota!\n");
                } else {
                    printf("%d ka Factorial = %lld\n", num, factorial(num));
                }
                break;

            case 2:
                printf("Number enter karein: ");
                scanf("%d", &num);
                if (num < 0) num = -num; // Negative number ko positive bana kar sum nikalna
                printf("Digits ka Sum = %d\n", sumOfDigits(num));
                break;

            case 3:
                printf("Base number enter karein: ");
                scanf("%d", &base);
                printf("Exponent (power) enter karein (non-negative): ");
                scanf("%d", &exp);
                if (exp < 0) {
                    printf("Negative exponent supported nahi hai!\n");
                } else {
                    printf("%d ^ %d = %lld\n", base, exp, power(base, exp));
                }
                break;

            case 4:
                printf("Fibonacci series ke kitne terms print karne hain? ");
                scanf("%d", &terms);
                if (terms <= 0) {
                    printf("Kripya 1 ya usse zyada terms enter karein!\n");
                } else {
                    printf("Fibonacci Series: ");
                    for (int i = 0; i < terms; i++) {
                        printf("%d ", fibonacci(i));
                    }
                    printf("\n");
                }
                break;

            case 5:
                printf("Do numbers enter karein (space dekar): ");
                scanf("%d %d", &num1, &num2);
                if (num1 < 0) num1 = -num1;
                if (num2 < 0) num2 = -num2;
                printf("%d aur %d ka GCD = %d\n", num1, num2, gcd(num1, num2));
                break;

            default:
                printf("Invalid choice! Kripya 1 se 6 ke beech number chunein.\n");
        }
        printf("----------------------------------------\n");
    }

    return 0;
}
