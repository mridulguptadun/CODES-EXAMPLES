Q6. Employee Bonus and Promotion System
Create a program that accepts employee salary, experience, and performance rating.
Use separate functions to calculate:
•	Experience bonus.
•	Performance bonus.
•	Promotion eligibility.
•	Final annual salary.
•	Monthly salary after bonuses.

#include <stdio.h>

// Experience ke basis par bonus calculate karne ka function
float calculateExperienceBonus(float annualSalary, int experience) {
    if (experience >= 10) {
        return 0.15 * annualSalary; // 15% bonus for 10+ years
    } else if (experience >= 5) {
        return 0.10 * annualSalary; // 10% bonus for 5-9 years
    } else if (experience >= 2) {
        return 0.05 * annualSalary; // 5% bonus for 2-4 years
    } else {
        return 0.0;                 // 2 saal se kam par koi experience bonus nahi
    }
}

// Performance rating (1 to 5) ke basis par bonus calculate karne ka function
float calculatePerformanceBonus(float annualSalary, int rating) {
    if (rating == 5) {
        return 0.20 * annualSalary; // 20% bonus for Rating 5
    } else if (rating == 4) {
        return 0.12 * annualSalary; // 12% bonus for Rating 4
    } else if (rating == 3) {
        return 0.05 * annualSalary; // 5% bonus for Rating 3
    } else {
        return 0.0;                 // Rating 1 ya 2 par koi performance bonus nahi
    }
}

// Promotion eligibility check karne ka function
void checkPromotionEligibility(int experience, int rating) {
    if (experience >= 3 && rating >= 4) {
        printf("Promotion Status      : ELIGIBLE for Promotion!\n");
    } else {
        printf("Promotion Status      : NOT ELIGIBLE (Min 3 yrs exp & 4+ rating required)\n");
    }
}

// Final annual salary calculate karne ka function
float calculateFinalAnnualSalary(float annualSalary, float expBonus, float perfBonus) {
    return annualSalary + expBonus + perfBonus;
}

// Bonuses ke baad monthly salary calculate karne ka function
float calculateMonthlySalary(float finalAnnualSalary) {
    return finalAnnualSalary / 12.0;
}

// Saari details display karne ka function
void displayEmployeeReport(float annualSalary, float expBonus, float perfBonus, float finalAnnual, float monthlySalary, int experience, int rating) {
    printf("\n=============================================\n");
    printf("     EMPLOYEE BONUS & PROMOTION REPORT       \n");
    printf("=============================================\n");
    printf("Base Annual Salary    : Rs. %.2f\n", annualSalary);
    printf("Experience Bonus      : Rs. %.2f\n", expBonus);
    printf("Performance Bonus     : Rs. %.2f\n", perfBonus);
    printf("---------------------------------------------\n");
    printf("Final Annual Salary   : Rs. %.2f\n", finalAnnual);
    printf("Monthly Salary        : Rs. %.2f\n", monthlySalary);
    printf("---------------------------------------------\n");
    checkPromotionEligibility(experience, rating);
    printf("=============================================\n");
}

int main() {
    float annualSalary;
    int experience, rating;

    printf("Employee ki Annual Salary enter karein: Rs. ");
    scanf("%f", &annualSalary);

    printf("Total Experience (in years) enter karein: ");
    scanf("%d", &experience);

    printf("Performance Rating enter karein (1 se 5 ke beech): ");
    scanf("%d", &rating);

    if (annualSalary < 0 || experience < 0 || rating < 1 || rating > 5) {
        printf("Invalid input! Kripya sahi values enter karein.\n");
        return 0;
    }

    // Separate functions se calculations
    float expBonus = calculateExperienceBonus(annualSalary, experience);
    float perfBonus = calculatePerformanceBonus(annualSalary, rating);
    float finalAnnualSalary = calculateFinalAnnualSalary(annualSalary, expBonus, perfBonus);
    float monthlySalary = calculateMonthlySalary(finalAnnualSalary);

    // Report display karna
    displayEmployeeReport(annualSalary, expBonus, perfBonus, finalAnnualSalary, monthlySalary, experience, rating);

    return 0;
}
