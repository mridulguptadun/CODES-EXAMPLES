Q3. Student Result Management System
Write a program using functions to:
•	Accept marks of 6 subjects.
•	Calculate total marks and percentage.
•	Find highest and lowest marks.
•	Calculate average marks.
•	Determine the student's grade.
•	Display pass or fail status.

#include <stdio.h>

// 6 subjects ke marks input lene ka function
void acceptMarks(float marks[]) {
    printf("6 subjects ke marks enter karein (out of 100):\n");
    for (int i = 0; i < 6; i++) {
        printf("Subject %d: ", i + 1);
        scanf("%f", &marks[i]);
    }
}

// Total marks calculate karne ka function
float calculateTotal(float marks[]) {
    float total = 0;
    for (int i = 0; i < 6; i++) {
        total += marks[i];
    }
    return total;
}

// Percentage calculate karne ka function
float calculatePercentage(float total) {
    return (total / 600.0) * 100.0;
}

// Average marks calculate karne ka function
float calculateAverage(float total) {
    return total / 6.0;
}

// Highest marks find karne ka function
float findHighest(float marks[]) {
    float highest = marks[0];
    for (int i = 1; i < 6; i++) {
        if (marks[i] > highest) {
            highest = marks[i];
        }
    }
    return highest;
}

// Lowest marks find karne ka function
float findLowest(float marks[]) {
    float lowest = marks[0];
    for (int i = 1; i < 6; i++) {
        if (marks[i] < lowest) {
            lowest = marks[i];
        }
    }
    return lowest;
}

// Grade determine karne ka function
char determineGrade(float percentage) {
    if (percentage >= 90) return 'A';
    else if (percentage >= 75) return 'B';
    else if (percentage >= 60) return 'C';
    else if (percentage >= 40) return 'D';
    else return 'F';
}

// Pass ya Fail status display karne ka function
void displayStatus(float marks[]) {
    int isPass = 1;
    for (int i = 0; i < 6; i++) {
        if (marks[i] < 33) { // Har subject mein minimum 33 marks zaroori hain
            isPass = 0;
            break;
        }
    }
    
    if (isPass) {
        printf("Result Status      : PASS\n");
    } else {
        printf("Result Status      : FAIL\n");
    }
}

// Poora result display karne ka function
void displayResult(float marks[], float total, float percentage, float average, float highest, float lowest, char grade) {
    printf("\n====================================\n");
    printf("        STUDENT RESULT CARD         \n");
    printf("====================================\n");
    printf("Total Marks        : %.2f / 600\n", total);
    printf("Percentage         : %.2f%%\n", percentage);
    printf("Average Marks      : %.2f\n", average);
    printf("Highest Marks      : %.2f\n", highest);
    printf("Lowest Marks       : %.2f\n", lowest);
    printf("Grade              : %c\n", grade);
    printf("------------------------------------\n");
    displayStatus(marks);
    printf("====================================\n");
}

int main() {
    float marks[6];

    // Marks input lena
    acceptMarks(marks);

    // Separate functions se calculations
    float total = calculateTotal(marks);
    float percentage = calculatePercentage(total);
    float average = calculateAverage(total);
    float highest = findHighest(marks);
    float lowest = findLowest(marks);
    char grade = determineGrade(percentage);

    // Result display karna
    displayResult(marks, total, percentage, average, highest, lowest, grade);

    return 0;
}
