Q19. String Analysis System
Write a C program using separate functions to:
•	Find string length without using strlen().
•	Count vowels and consonants.
•	Count words.
•	Reverse a string.
•	Check whether a string is a palindrome.
•	Convert lowercase characters to uppercase.

#include <stdio.h>

// 1. Bina strlen() ke string length nikalne ka function
int findLength(char str[]) {
    int len = 0;
    while (str[len] != '\0') {
        len++;
    }
    return len;
}

// 2. Vowels aur Consonants count karne ka function
void countVowelsAndConsonants(char str[], int *vowels, int *consonants) {
    *vowels = 0;
    *consonants = 0;

    for (int i = 0; str[i] != '\0'; i++) {
        char ch = str[i];
        if ((ch >= 'a' && ch <= 'z') || (ch >= 'A' && ch <= 'Z')) {
            if (ch == 'a' || ch == 'e' || ch == 'i' || ch == 'o' || ch == 'u' ||
                ch == 'A' || ch == 'E' || ch == 'I' || ch == 'O' || ch == 'U') {
                (*vowels)++;
            } else {
                (*consonants)++;
            }
        }
    }
}

// 3. Total words count karne ka function
int countWords(char str[]) {
    int words = 0, inWord = 0;
    for (int i = 0; str[i] != '\0'; i++) {
        if (str[i] == ' ' || str[i] == '\t' || str[i] == '\n') {
            inWord = 0;
        } else if (inWord == 0) {
            inWord = 1;
            words++;
        }
    }
    return words;
}

// 4. String ko reverse karne ka function
void reverseString(char str[], char rev[]) {
    int len = findLength(str);
    for (int i = 0; i < len; i++) {
        rev[i] = str[len - 1 - i];
    }
    rev[len] = '\0';
}

// 5. Palindrome check karne ka function (Case-insensitive)
int isPalindrome(char str[]) {
    int left = 0;
    int right = findLength(str) - 1;

    while (left < right) {
        char c1 = str[left];
        char c2 = str[right];

        // Comparison ke liye lowercase mein convert karna
        if (c1 >= 'A' && c1 <= 'Z') c1 += 32;
        if (c2 >= 'A' && c2 <= 'Z') c2 += 32;

        if (c1 != c2) {
            return 0; // Palindrome nahi hai
        }
        left++;
        right--;
    }
    return 1; // Palindrome hai
}

// 6. Lowercase characters ko Uppercase mein convert karne ka function
void toUpperCase(char str[], char upper[]) {
    int i = 0;
    while (str[i] != '\0') {
        if (str[i] >= 'a' && str[i] <= 'z') {
            upper[i] = str[i] - 32;
        } else {
            upper[i] = str[i];
        }
        i++;
    }
    upper[i] = '\0';
}

// Poora analysis display karne ka function
void displayAnalysis(char str[]) {
    int vowels, consonants;
    char reversed[200], uppercase[200];

    int length = findLength(str);
    countVowelsAndConsonants(str, &vowels, &consonants);
    int words = countWords(str);
    reverseString(str, reversed);
    toUpperCase(str, uppercase);

    printf("\n========================================\n");
    printf("        STRING ANALYSIS REPORT          \n");
    printf("========================================\n");
    printf("Original String   : %s\n", str);
    printf("String Length     : %d\n", length);
    printf("Vowels Count      : %d\n", vowels);
    printf("Consonants Count  : %d\n", consonants);
    printf("Words Count       : %d\n", words);
    printf("Reversed String   : %s\n", reversed);
    printf("Uppercase String  : %s\n", uppercase);
    if (isPalindrome(str)) {
        printf("Palindrome Check  : YES (Palindrome)\n");
    } else {
        printf("Palindrome Check  : NO (Not Palindrome)\n");
    }
    printf("========================================\n");
}

int main() {
    char str[200];

    printf("Koi bhi string ya sentence enter karein: ");
    scanf(" %[^\n]", str); // Spaces ke saath poori line read karne ke liye

    displayAnalysis(str);

    return 0;
}
