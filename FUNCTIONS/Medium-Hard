Q9. Number Analysis System
Write a program using separate functions to check whether a number is:
•	Prime.
•	Armstrong.
•	Palindrome.
•	Perfect.
•	Even or Odd.
Display all applicable results for the entered number.

#include <stdio.h>

// Prime number check karne ka function
int isPrime(int num) {
    if (num <= 1) return 0;
    for (int i = 2; i <= num / 2; i++) {
        if (num % i == 0) {
            return 0;
        }
    }
    return 1;
}

// Armstrong number check karne ka function
int isArmstrong(int num) {
    if (num < 0) return 0;
    int original = num, digits = 0, sum = 0, temp = num;

    // Total digits count karna
    while (temp != 0) {
        digits++;
        temp /= 10;
    }

    temp = num;
    while (temp != 0) {
        int rem = temp % 10;
        int power = 1;
        for (int i = 0; i < digits; i++) {
            power *= rem;
        }
        sum += power;
        temp /= 10;
    }

    return (sum == original);
}

// Palindrome number check karne ka function
int isPalindrome(int num) {
    if (num < 0) return 0;
    int original = num, reversed = 0;

    while (num != 0) {
        int rem = num % 10;
        reversed = reversed * 10 + rem;
        num /= 10;
    }

    return (original == reversed);
}

// Perfect number check karne ka function
int isPerfect(int num) {
    if (num <= 1) return 0;
    int sum = 0;

    for (int i = 1; i <= num / 2; i++) {
        if (num % i == 0) {
            sum += i;
        }
    }

    return (sum == num);
}

// Even ya Odd check karne ka function
void checkEvenOdd(int num) {
    if (num % 2 == 0) {
        printf("Even / Odd   : EVEN Number\n");
    } else {
        printf("Even / Odd   : ODD Number\n");
    }
}

