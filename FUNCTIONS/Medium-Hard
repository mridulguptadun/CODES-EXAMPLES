Q23. Array-Based Sales Analysis System
Write a C program using functions to analyze monthly sales data for 12 months.
•	Calculate total annual sales.
•	Calculate average monthly sales.
•	Find the highest and lowest sales months.
•	Calculate quarterly sales.
•	Identify months with sales above average.
•	Calculate annual growth percentage.

#include <stdio.h>

// 12 months ka sales data input lene ka function
void acceptSalesData(float sales[], char months[]) {
    printf("12 months ka sales data enter karein:\n");
    for (int i = 0; i < 12; i++) {
        printf("%s ki sales: Rs. ", months[i]);
        scanf("%f", &sales[i]);
    }
}

// 1. Total annual sales calculate karne ka function
float calculateTotalSales(float sales[]) {
    float total = 0;
    for (int i = 0; i < 12; i++) {
        total += sales[i];
    }
    return total;
}

// 2. Average monthly sales calculate karne ka function
float calculateAverageSales(float total) {
    return total / 12.0;
}

// 3. Highest sales month find aur display karne ka function
void findHighestSalesMonth(float sales[], char months[]) {
    int maxIdx = 0;
    for (int i = 1; i < 12; i++) {
        if (sales[i] > sales[maxIdx]) {
            maxIdx = i;
        }
    }
    printf("Highest Sales Month      : %s (Rs. %.2f)\n", months[maxIdx], sales[maxIdx]);
}

// 4. Lowest sales month find aur display karne ka function
void findLowestSalesMonth(float sales[], char months[]) {
    int minIdx = 0;
    for (int i = 1; i < 12; i++) {
        if (sales[i] < sales[minIdx]) {
            minIdx = i;
        }
    }
    printf("Lowest Sales Month       : %s (Rs. %.2f)\n", months[minIdx], sales[minIdx]);
}

// 5. Quarterly sales calculate aur display karne ka function
void calculateQuarterlySales(float sales[]) {
    float q1 = sales + sales + sales;
    float q2 = sales + sales + sales;
    float q3 = sales + sales + sales;
    float q4 = sales + sales + sales;

    printf("\n--- QUARTERLY SALES BREAKDOWN ---\n");
    printf("Quarter 1 (Jan - Mar)    : Rs. %.2f\n", q1);
    printf("Quarter 2 (Apr - Jun)    : Rs. %.2f\n", q2);
    printf("Quarter 3 (Jul - Sep)    : Rs. %.2f\n", q3);
    printf("Quarter 4 (Oct - Dec)    : Rs. %.2f\n", q4);
}

// 6. Average se zyada sales wale months identify karne ka function
void displayAboveAverageMonths(float sales[], char months[], float average) {
    printf("\n--- MONTHS WITH ABOVE-AVERAGE SALES (> Rs. %.2f) ---\n", average);
    int found = 0;
    for (int i = 0; i < 12; i++) {
        if (sales[i] > average) {
            printf("-> %-10s : Rs. %.2f\n", months[i], sales[i]);
            found = 1;
        }
    }
    if (!found) {
        printf("Koi bhi month average se zyada nahi hai.\n");
    }
}

// 7. Annual growth percentage calculate karne ka function (Jan se Dec tak ka growth)
float calculateAnnualGrowth(float sales[]) {
    if (sales == 0) {
        return 0.0; // Division by zero se bachne ke liye
    }
    return ((sales - sales) / sales) * 100.0;
}

// Complete sales analysis report display karne ka function
void displaySalesReport(float sales[], char months[], float total, float average, float growth) {
    printf("\n=====================================================\n");
    printf("            ANNUAL SALES ANALYSIS REPORT             \n");
    printf("=====================================================\n");
    printf("Total Annual Sales       : Rs. %.2f\n", total);
    printf("Average Monthly Sales    : Rs. %.2f\n", average);
    findHighestSalesMonth(sales, months);
    findLowestSalesMonth(sales, months);
    printf("Annual Growth (Jan->Dec) : %.2f%%\n", growth);
    calculateQuarterlySales(sales);
    displayAboveAverageMonths(sales, months, average);
    printf("=====================================================\n");
}

int main() {
    float sales;
    char months = {
        "January", "February", "March", "April", "May", "June",
        "July", "August", "September", "October", "November", "December"
    };

    // 12 months ka data input lena
    acceptSalesData(sales, months);

    // Separate functions se calculations
    float total = calculateTotalSales(sales);
    float average = calculateAverageSales(total);
    float growth = calculateAnnualGrowth(sales);

    // Complete report display karna
    displaySalesReport(sales, months, total, average, growth);

    return 0;
}
