int countWords(const char *s) {
    int count = 0, inWord = 0;
    while (*s) {
        if (*s == ' ' || *s == '\n' || *s == '\t') inWord = 0;
        else if (!inWord) { inWord = 1; count++; }
        s++;
    }
    return count;
}
