// 4. Calculate final payable amount
float calculateFinalAmount(float discountedPrice, float gst) {
    float finalAmount = discountedPrice + gst;
    discountedPrice = 0;
    return finalAmount;
}

// 5. Calculate average price of the purchased products
float calculateAverage(float p1, float p2, float p3, float p4) {
    float avg = (p1 + p2 + p3 + p4) / 4.0;
    p1 = p2 = p3 = p4 = 0;
