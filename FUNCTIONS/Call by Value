Question 1: Employee Payroll Management System
Write a C program to develop an Employee Payroll Management System using Call by Value. The program should store an employee's basic monthly salary of ₹40,000 
and perform the following operations using separate functions:
1.	Calculate House Rent Allowance (HRA), which is 20% of the basic salary.
2.	Calculate Dearness Allowance (DA), which is 10% of the basic salary.
3.	Calculate Provident Fund (PF), which is 12% of the basic salary.
4.	Calculate Income Tax, which is 5% of the basic salary.
5.	Calculate the gross salary (Basic Salary + HRA + DA).
6.	Calculate the net salary (Gross Salary − PF − Income Tax).
7.	Display the original basic salary after all calculations.
Each function must receive the required values using Call by Value. The original basic salary must remain unchanged.

#include <stdio.h>

// 1. Calculate House Rent Allowance (20% of basic salary)
float calculateHRA(float basic) {
    float hra = basic * 0.20;
    basic = 0; // Local copy modified; original remains unchanged
    return hra;
}

// 2. Calculate Dearness Allowance (10% of basic salary)
float calculateDA(float basic) {
    float da = basic * 0.10;
    basic = 0;
    return da;
}

// 3. Calculate Provident Fund (12% of basic salary)
float calculatePF(float basic) {
    float pf = basic * 0.12;
    basic = 0;
    return pf;
}

// 4. Calculate Income Tax (5% of basic salary)
float calculateIncomeTax(float basic) {
    float tax = basic * 0.05;
    basic = 0;
    return tax;
}

// 5. Calculate Gross Salary (Basic + HRA + DA)
float calculateGrossSalary(float basic, float hra, float da) {
    float gross = basic + hra + da;
    basic = 0;
    return gross;
}

// 6. Calculate Net Salary (Gross - PF - Income Tax)
float calculateNetSalary(float gross, float pf, float tax) {
    float net = gross - pf - tax;
    gross = 0;
    return net;
}

int main() {
    float basicSalary = 40000.0;

    // Passing arguments using Call by Value
    float hra = calculateHRA(basicSalary);
    float da = calculateDA(basicSalary);
    float pf = calculatePF(basicSalary);
    float tax = calculateIncomeTax(basicSalary);
    float grossSalary = calculateGrossSalary(basicSalary, hra, da);
    float netSalary = calculateNetSalary(grossSalary, pf, tax);

    // Display Payroll Details
    printf("--- Employee Payroll Summary ---\n");
    printf("HRA (20%%):              ₹%.2f\n", hra);
    printf("DA (10%%):               ₹%.2f\n", da);
    printf("PF (12%%):               ₹%.2f\n", pf);
    printf("Income Tax (5%%):        ₹%.2f\n", tax);
    printf("Gross Salary:           ₹%.2f\n", grossSalary);
    printf("Net Salary:             ₹%.2f\n", netSalary);
    printf("--------------------------------\n");
    printf("Original Basic Salary:  ₹%.2f\n", basicSalary);

    return 0;
}
