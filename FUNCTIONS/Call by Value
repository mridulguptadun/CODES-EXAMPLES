Question 4: Hotel Reservation and Billing System
Write a C program to develop a Hotel Reservation and Billing System using Call by Value. A customer books a hotel room with the following details:
•	Room Rent Per Day: ₹2,500
•	Number of Days: 5
•	Food Charges: ₹3,000
•	Laundry Charges: ₹1,000
•	Service Tax: 10%
The program should perform the following operations using separate functions:
1.	Calculate the total room rent.
2.	Calculate the total additional charges (Food + Laundry).
3.	Calculate the subtotal amount.
4.	Calculate 10% service tax on the subtotal.
5.	Calculate the final hotel bill.
6.	Calculate the average daily room rent.
7.	Display the original booking details after all calculations.
Use Call by Value for all required function arguments. Original booking details must remain unchanged.

#include <stdio.h>

// 1. Calculate total room rent
float calculateRoomRent(float rentPerDay, int days) {
    float totalRent = rentPerDay * days;
    rentPerDay = 0; // Local copies modified; originals remain unchanged
    days = 0;
    return totalRent;
}

// 2. Calculate total additional charges (Food + Laundry)
float calculateAdditionalCharges(float food, float laundry) {
    float additional = food + laundry;
    food = laundry = 0;
    return additional;
}

// 3. Calculate subtotal amount
float calculateSubtotal(float roomRent, float additionalCharges) {
    float subtotal = roomRent + additionalCharges;
    roomRent = additionalCharges = 0;
    return subtotal;
}

// 4. Calculate 10% service tax on the subtotal
float calculateServiceTax(float subtotal) {
    float tax = subtotal * 0.10;
    subtotal = 0;
    return tax;
}

// 5. Calculate final hotel bill
float calculateFinalBill(float subtotal, float serviceTax) {
    float finalBill = subtotal + serviceTax;
    subtotal = serviceTax = 0;
    return finalBill;
}

// 6. Calculate average daily room rent
float calculateAverageDailyRent(float totalRoomRent, int days) {
    float avgRent = totalRoomRent / days;
    totalRoomRent = 0;
    days = 0;
    return avgRent;
}

int main() {
    float roomRentPerDay = 2500.0;
    int numDays = 5;
    float foodCharges = 3000.0;
    float laundryCharges = 1000.0;

    // Performing calculations using Call by Value
    float totalRoomRent = calculateRoomRent(roomRentPerDay, numDays);
    float totalAdditional = calculateAdditionalCharges(foodCharges, laundryCharges);
    float subtotal = calculateSubtotal(totalRoomRent, totalAdditional);
    float serviceTax = calculateServiceTax(subtotal);
    float finalBill = calculateFinalBill(subtotal, serviceTax);
    float averageDailyRent = calculateAverageDailyRent(totalRoomRent, numDays);

    // Display Hotel Billing Summary
    printf("--- Hotel Reservation & Billing Summary ---\n");
    printf("Total Room Rent (5 days): ₹%.2f\n", totalRoomRent);
    printf("Additional Charges:       ₹%.2f\n", totalAdditional);
    printf("Subtotal Amount:          ₹%.2f\n", subtotal);
    printf("Service Tax (10%%):        ₹%.2f\n", serviceTax);
    printf("Final Hotel Bill:         ₹%.2f\n", finalBill);
    printf("Average Daily Room Rent:  ₹%.2f\n", averageDailyRent);
    printf("-------------------------------------------\n");

    // 7. Display original booking details after all calculations
    printf("Original Booking Details:\n");
    printf("Room Rent Per Day:        ₹%.2f\n", roomRentPerDay);
    printf("Number of Days:           %d\n", numDays);
    printf("Food Charges:             ₹%.2f\n", foodCharges);
    printf("Laundry Charges:          ₹%.2f\n", laundryCharges);

    return 0;
}
