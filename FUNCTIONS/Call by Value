#include <stdio.h>
// 1. Calculate total price of all products
float calculateTotal(float p1, float p2, float p3, float p4) {
    float total = p1 + p2 + p3 + p4;
    p1 = p2 = p3 = p4 = 0; // Local copies modified; originals remain unchanged
    return total;
}

// 2. Calculate 10% discount on the total price
float calculateDiscount(float total) {
    float discount = total * 0.10;
    total = 0;
    return discount;
}

