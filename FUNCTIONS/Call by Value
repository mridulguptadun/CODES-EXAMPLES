Question 1: Bank Tax Calculation
Write a C program using Call by Value to calculate 10% tax on a customer's bank balance of ₹50,000. Display the tax amount and the original 
bank balance. The original balance should remain unchanged.

#include <stdio.h>
// Function to calculate tax using Call by Value
float calculateTax(float bal) {
    float tax = bal * 0.10;
    bal = bal - tax; // Modifies only the local copy, not the original balance
    return tax;
}

int main() {
    float balance = 50000.0;
    float taxAmount;

    // Passing 'balance' by value
    taxAmount = calculateTax(balance);

    printf("Tax Amount (10%%): ₹%.2f\n", taxAmount);
    printf("Original Bank Balance: ₹%.2f\n", balance);

    return 0;
}
