Question 3: Student Academic Performance Management System
Write a C program to develop a Student Academic Performance Management System using Call by Value. A student has obtained the following marks:
•	Mathematics: 85
•	Physics: 78
•	Chemistry: 92
•	English: 88
•	Computer Science: 95
Each subject has a maximum of 100 marks.
The program should perform the following operations using separate functions:
1.	Calculate the total marks obtained.
2.	Calculate the overall percentage.
3.	Calculate the average marks.
4.	Find the highest marks.
5.	Find the lowest marks.
6.	Calculate the percentage of each subject.
7.	Display the original marks after all calculations.
Use Call by Value for passing the required values to functions. Original marks must remain unchanged.

#include <stdio.h>

// 1. Calculate total marks obtained
int calculateTotal(int m1, int m2, int m3, int m4, int m5) {
    int total = m1 + m2 + m3 + m4 + m5;
    m1 = m2 = m3 = m4 = m5 = 0; // Local copies modified; originals remain unchanged
    return total;
}

// 2. Calculate overall percentage (out of 500)
float calculateOverallPercentage(int total) {
    float percentage = ((float)total / 500.0) * 100.0;
    total = 0;
    return percentage;
}

// 3. Calculate average marks
float calculateAverage(int total) {
    float avg = (float)total / 5.0;
    total = 0;
    return avg;
}

// 4. Find highest marks
int findHighest(int m1, int m2, int m3, int m4, int m5) {
    int max = m1;
    if (m2 > max) max = m2;
    if (m3 > max) max = m3;
    if (m4 > max) max = m4;
    if (m5 > max) max = m5;
    m1 = m2 = m3 = m4 = m5 = 0;
    return max;
}

// 5. Find lowest marks
int findLowest(int m1, int m2, int m3, int m4, int m5) {
    int min = m1;
    if (m2 < min) min = m2;
    if (m3 < min) min = m3;
    if (m4 < min) min = m4;
    if (m5 < min) min = m5;
    m1 = m2 = m3 = m4 = m5 = 0;
    return min;
}

// 6. Calculate percentage of an individual subject (out of 100)
float calculateSubjectPercentage(int mark) {
    float subPerc = ((float)mark / 100.0) * 100.0;
    mark = 0;
    return subPerc;
}

int main() {
    int math = 85;
    int physics = 78;
    int chemistry = 92;
    int english = 88;
    int compSci = 95;

    // Performing calculations using Call by Value
    int totalMarks = calculateTotal(math, physics, chemistry, english, compSci);
    float overallPercentage = calculateOverallPercentage(totalMarks);
    float averageMarks = calculateAverage(totalMarks);
    int highestMarks = findHighest(math, physics, chemistry, english, compSci);
    int lowestMarks = findLowest(math, physics, chemistry, english, compSci);

    // Display Academic Performance Summary
    printf("--- Student Academic Performance Summary ---\n");
    printf("Total Marks (out of 500): %d\n", totalMarks);
    printf("Overall Percentage:       %.2f%%\n", overallPercentage);
    printf("Average Marks:            %.2f\n", averageMarks);
    printf("Highest Marks:            %d\n", highestMarks);
    printf("Lowest Marks:             %d\n", lowestMarks);
