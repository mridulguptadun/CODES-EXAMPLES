25. Check if a file exists, print its size in bytes, and rename it.
python
import os

old_name = "backup.txt"
new_name = "archived_notes.txt"

if os.path.exists(old_name):
    print("File size (bytes):", os.path.getsize(old_name))
    os.rename(old_name, new_name)
    print("Renamed successfully.")
else:
    print("File not found.")
