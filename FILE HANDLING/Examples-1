22. Read a CSV file and print students who scored more than 80.
python
import csv

with open("students.csv", "r") as file:
    reader = csv.DictReader(file)
    for row in reader:
        if int(row["Marks"]) > 80:
            print(row["Name"], "-", row["Marks"])
