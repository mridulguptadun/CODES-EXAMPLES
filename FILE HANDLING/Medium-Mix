6. Write a function to read numbers from a file and return their sum, skipping any non-numeric lines (ValueError).

def sum_numbers_in_file(filename):
    total = 0
    try:
        with open(filename, "r") as f:
            for line in f:
                try:
                    total += float(line.strip())
                except ValueError:
                    print(f"Skipping invalid number: {line.strip()}")
        return total
    except FileNotFoundError:
        return 0

print("Total Sum:", sum_numbers_in_file("numbers.txt"))
