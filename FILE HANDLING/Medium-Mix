15. Write an error-logging function that records any exception message with a timestamp into error_log.txt when another function fails.

from datetime import datetime

def log_error(error_msg):
    with open("error_log.txt", "a") as log:
        time_now = datetime.now().strftime("%Y-%m-%d %H:%M:%S")
        log.write(f"[{time_now}] ERROR: {error_msg}\n")

def risky_division(a, b):
    try:
        return a / b
    except Exception as e:
        log_error(e)
        print("Something went wrong! Error saved to error_log.txt.")

risky_division(10, 0)
