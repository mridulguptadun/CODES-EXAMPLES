12. Write a function to save a student's name and marks to a CSV file, raising a ValueError if marks are not between 0 and 100.

import csv

def add_student(filename, name, marks):
    try:
        if marks < 0 or marks > 100:
            raise ValueError("Marks must be between 0 and 100.")
        with open(filename, "a", newline="") as f:
            writer = csv.writer(f)
            writer.writerow([name, marks])
        print("Student record added!")
    except ValueError as e:
        print("Validation Error:", e)
    except IOError:
        print("Failed to save the record.")

add_student("students.csv", "Rohan", 88)
===================================================================================================
13. Write a function to replace a word in a file and use a finally block to confirm the operation finished.

def replace_word_in_file(filename, old_word, new_word):
    try:
        with open(filename, "r") as f:
            text = f.read()
        text = text.replace(old_word, new_word)
        with open(filename, "w") as f:
            f.write(text)
        print("Word replaced successfully.")
    except FileNotFoundError:
        print("File not found.")
    finally:
        print("File operation process completed.")

replace_word_in_file("notes.txt", "awesome", "powerful")
