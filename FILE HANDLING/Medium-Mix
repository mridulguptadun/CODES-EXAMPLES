10. Write a function to search for a word in a file and raise a custom ValueError if the file is completely empty.

def search_word(filename, word):
    try:
        with open(filename, "r") as f:
            content = f.read()
            if not content.strip():
                raise ValueError("The file is completely empty!")
            if word in content:
                print(f"'{word}' found!")
            else:
                print(f"'{word}' not found.")
    except (FileNotFoundError, ValueError) as e:
        print("Error:", e)

search_word("notes.txt", "Python")
