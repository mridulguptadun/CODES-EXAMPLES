9. Write a function to print a specific line number from a file, handling out-of-range line numbers (IndexError).

def get_specific_line(filename, line_no):
    try:
        with open(filename, "r") as f:
            lines = f.readlines()
            print(f"Line {line_no}:", lines[line_no - 1].strip())
    except FileNotFoundError:
        print("File not found.")
    except IndexError:
        print(f"Error: Line {line_no} does not exist in the file.")

