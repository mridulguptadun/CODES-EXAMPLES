8. Write a function to calculate the average of marks stored in a file, handling an empty file (ZeroDivisionError).

def average_marks(filename):
    try:
        with open(filename, "r") as f:
            marks = [int(line.strip()) for line in f if line.strip()]
            avg = sum(marks) / len(marks)
            print("Average Marks:", avg)
    except FileNotFoundError:
        print("Marks file is missing.")
    except ZeroDivisionError:
        print("File is empty, cannot calculate average.")
    except ValueError:
        print("Invalid data format inside the file.")

average_marks("marks.txt")
