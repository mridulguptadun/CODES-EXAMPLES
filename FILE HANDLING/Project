Project 5: Simple Banking System (Account Ledger)

Problem Statement: Build a multi-user banking system storing {account_no: {"holder": str, "balance": float}} in bank_accounts.json. 
Support account creation, deposits, and withdrawals while preventing overdrafts (InsufficientFunds via ValueError) and invalid account lookups.

import json

FILE_NAME = "bank_accounts.json"

def load_accounts():
    try:
        with open(FILE_NAME, "r") as f:
            return json.load(f)
    except (FileNotFoundError, json.JSONDecodeError):
        return {}

def save_accounts(accounts):
    with open(FILE_NAME, "w") as f:
        json.dump(accounts, f, indent=4)

def create_account(accounts):
    try:
        acc_no = input("Enter New Account Number: ").strip()
        if acc_no in accounts:
            raise ValueError("Account number already exists.")
        holder = input("Account Holder Name: ").strip().title()
        deposit = float(input("Initial Deposit (₹): "))
        if deposit < 500:
            raise ValueError("Minimum initial deposit is ₹500.")
        
        accounts[acc_no] = {"holder": holder, "balance": deposit}
        save_accounts(accounts)
        print("Account created successfully!")
    except ValueError as e:
        print("Error:", e)

def update_balance(accounts, is_deposit=True):
    try:
        acc_no = input("Enter Account Number: ").strip()
        if acc_no not in accounts:
            raise KeyError("Account not found.")
        amount = float(input("Enter Amount (₹): "))
        if amount <= 0:
            raise ValueError("Amount must be positive.")
        
        if is_deposit:
            accounts[acc_no]["balance"] += amount
            print(f"Deposited ₹{amount}. New Balance: ₹{accounts[acc_no]['balance']:.2f}")
        else:
            if amount > accounts[acc_no]["balance"]:
                raise ValueError("Insufficient balance!")
            accounts[acc_no]["balance"] -= amount
            print(f"Withdrew ₹{amount}. New Balance: ₹{accounts[acc_no]['balance']:.2f}")
        
        save_accounts(accounts)
    except (KeyError, ValueError) as e:
        print("Transaction Error:", e)

def check_balance(accounts):
    acc_no = input("Enter Account Number: ").strip()
    try:
        acc = accounts[acc_no]
        print(f"Holder: {acc['holder']} | Balance: ₹{acc['balance']:.2f}")
    except KeyError:
        print("Invalid Account Number.")

def main():
    accounts = load_accounts()
    while True:
        print("\n1. Create Account | 2. Deposit | 3. Withdraw | 4. Check Balance | 5. Exit")
        ch = input("Choose: ")
        if ch == "1":
            create_account(accounts)
        elif ch == "2":
            update_balance(accounts, is_deposit=True)
        elif ch == "3":
            update_balance(accounts, is_deposit=False)
        elif ch == "4":
            check_balance(accounts)
        elif ch == "5":
            break

main()
