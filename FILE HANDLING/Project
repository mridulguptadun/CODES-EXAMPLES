Project 4: Contact Book with Search & Delete

Problem Statement: Develop a contact book application storing {name: {"phone": str, "email": str}} in contacts.json. 
Validate that phone numbers contain only 10 digits and handle missing contacts gracefully.

import json

FILE_NAME = "contacts.json"

def load_contacts():
    try:
        with open(FILE_NAME, "r") as f:
            return json.load(f)
    except (FileNotFoundError, json.JSONDecodeError):
        return {}

def save_contacts(contacts):
    with open(FILE_NAME, "w") as f:
        json.dump(contacts, f, indent=4)

def add_contact(contacts):
    try:
        name = input("Contact Name: ").strip().title()
        if not name:
            raise ValueError("Name cannot be blank.")
        phone = input("10-Digit Phone Number: ").strip()
        if not (phone.isdigit() and len(phone) == 10):
            raise ValueError("Phone number must be exactly 10 digits.")
        email = input("Email Address: ").strip()
        
        contacts[name] = {"phone": phone, "email": email}
        save_contacts(contacts)
        print(f"Contact '{name}' saved!")
    except ValueError as e:
        print("Validation Error:", e)

def search_contact(contacts):
    name = input("Enter name to search: ").strip().title()
    try:
        info = contacts[name]
        print(f"Name: {name} | Phone: {info['phone']} | Email: {info['email']}")
    except KeyError:
        print(f"No contact found with name '{name}'.")

def delete_contact(contacts):
    name = input("Enter name to delete: ").strip().title()
    try:
        del contacts[name]
        save_contacts(contacts)
        print(f"Contact '{name}' deleted.")
    except KeyError:
        print(f"Cannot delete: '{name}' does not exist.")

def main():
    contacts = load_contacts()
    while True:
        print("\n1. Add Contact | 2. Search | 3. Delete | 4. Show All | 5. Exit")
        choice = input("Select: ")
        if choice == "1":
            add_contact(contacts)
        elif choice == "2":
            search_contact(contacts)
        elif choice == "3":
            delete_contact(contacts)
        elif choice == "4":
            for name, info in contacts.items():
                print(f"{name}: {info['phone']} ({info['email']})")
        elif choice == "5":
            break

main()
