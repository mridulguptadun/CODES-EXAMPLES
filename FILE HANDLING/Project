Project 1: Personal Expense Tracker

Problem Statement: Build a menu-driven expense tracker that stores daily expenses in a dictionary (category: amount) and saves them permanently to a expenses.json file. 
Handle invalid numeric inputs, negative amounts, and missing/corrupted files.

import json

FILE_NAME = "expenses.json"

def load_expenses():
    try:
        with open(FILE_NAME, "r") as f:
            return json.load(f)
    except (FileNotFoundError, json.JSONDecodeError):
        return {}

def save_expenses(expenses):
    try:
        with open(FILE_NAME, "w") as f:
            json.dump(expenses, f, indent=4)
    except IOError as e:
        print("Error saving file:", e)

def add_expense(expenses):
    try:
        category = input("Enter category (Food, Travel, Bills, etc.): ").strip().title()
        if not category:
            raise ValueError("Category cannot be empty.")
        amount = float(input("Enter amount (₹): "))
        if amount <= 0:
            raise ValueError("Amount must be greater than zero.")
        
        expenses[category] = expenses.get(category, 0) + amount
        save_expenses(expenses)
        print(f"Added ₹{amount} under '{category}'.")
    except ValueError as e:
        print("Invalid input:", e)

def view_summary(expenses):
    if not expenses:
        print("No expenses recorded yet.")
        return
    print("\n--- Expense Summary ---")
    total = 0
    for category, amount in expenses.items():
        print(f"{category}: ₹{amount:.2f}")
        total += amount
    print(f"Total Spent: ₹{total:.2f}")

def main():
    expenses = load_expenses()
    while True:
        print("\n1. Add Expense | 2. View Summary | 3. Exit")
        choice = input("Choose an option: ")
        if choice == "1":
            add_expense(expenses)
        elif choice == "2":
            view_summary(expenses)
        elif choice == "3":
            print("Goodbye!")
            break
        else:
            print("Invalid choice. Try again.")

main()
