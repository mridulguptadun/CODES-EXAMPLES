Project 3: Grocery Store Inventory System

Problem Statement: Build an inventory management program where products are stored as {item_name: {"price": float, "stock": int}} in inventory.json. 
Allow adding stock, purchasing items (which reduces stock), and raising custom errors if stock is insufficient.

import json

FILE_NAME = "inventory.json"

def load_inventory():
    try:
        with open(FILE_NAME, "r") as f:
            return json.load(f)
    except (FileNotFoundError, json.JSONDecodeError):
        return {}

def save_inventory(inv):
    with open(FILE_NAME, "w") as f:
        json.dump(inv, f, indent=4)

def add_item(inv):
    try:
        item = input("Item Name: ").strip().title()
        price = float(input("Price per unit (₹): "))
        qty = int(input("Stock Quantity: "))
        if price <= 0 or qty < 0:
            raise ValueError("Price must be positive and stock cannot be negative.")
        
        if item in inv:
            inv[item]["stock"] += qty
            inv[item]["price"] = price
        else:
            inv[item] = {"price": price, "stock": qty}
        save_inventory(inv)
        print(f"Updated '{item}' in inventory.")
    except ValueError as e:
        print("Input Error:", e)

def buy_item(inv):
    try:
        item = input("Enter item to buy: ").strip().title()
        if item not in inv:
            raise KeyError("Item not available in store.")
        qty = int(input("Quantity to buy: "))
        if qty <= 0:
            raise ValueError("Quantity must be at least 1.")
        if qty > inv[item]["stock"]:
            raise ValueError(f"Only {inv[item]['stock']} units left in stock!")
        
        bill = qty * inv[item]["price"]
        inv[item]["stock"] -= qty
        save_inventory(inv)
        print(f"Purchase successful! Total Bill: ₹{bill:.2f}")
    except (KeyError, ValueError) as e:
        print("Transaction Failed:", e)

def display_stock(inv):
    if not inv:
        print("Inventory is empty.")
        return
    print("\n--- Current Stock ---")
    for item, details in inv.items():
        print(f"{item}: ₹{details['price']} | Stock: {details['stock']}")

def main():
    inventory = load_inventory()
    while True:
        print("\n1. Add/Update Stock | 2. Buy Item | 3. View Stock | 4. Exit")
        ch = input("Choice: ")
        if ch == "1":
            add_item(inventory)
        elif ch == "2":
            buy_item(inventory)
        elif ch == "3":
            display_stock(inventory)
        elif ch == "4":
            break

main()
