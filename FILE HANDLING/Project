Project 2: Student Gradebook Manager

Problem Statement: Create a student record manager using a nested dictionary ({roll_no: {"name": str, "marks": int}}) saved in students.json. Include features to add students, 
search by roll number, and calculate the class average while handling duplicate IDs and invalid marks.

import json

FILE_NAME = "students.json"

def load_data():
    try:
        with open(FILE_NAME, "r") as f:
            return json.load(f)
    except (FileNotFoundError, json.JSONDecodeError):
        return {}

def save_data(data):
    with open(FILE_NAME, "w") as f:
        json.dump(data, f, indent=4)

def add_student(students):
    try:
        roll = input("Enter Roll Number: ").strip()
        if roll in students:
            raise KeyError("Roll number already exists!")
        name = input("Enter Student Name: ").strip().title()
        marks = float(input("Enter Marks (0-100): "))
        if not (0 <= marks <= 100):
            raise ValueError("Marks must be between 0 and 100.")
        
        students[roll] = {"name": name, "marks": marks}
        save_data(students)
        print("Student added successfully!")
    except (KeyError, ValueError) as e:
        print("Error:", e)

def search_student(students):
    roll = input("Enter Roll Number to search: ").strip()
    try:
        record = students[roll]
        print(f"Name: {record['name']} | Marks: {record['marks']}")
    except KeyError:
        print("Student not found!")

def class_average(students):
    try:
        total = sum(info["marks"] for info in students.values())
        avg = total / len(students)
        print(f"Class Average: {avg:.2f}")
    except ZeroDivisionError:
        print("No student records available to calculate average.")

def main():
    students = load_data()
    while True:
        print("\n1. Add Student | 2. Search Student | 3. Class Average | 4. Exit")
        choice = input("Enter choice: ")
        if choice == "1":
            add_student(students)
        elif choice == "2":
            search_student(students)
        elif choice == "3":
            class_average(students)
        elif choice == "4":
            break
        else:
            print("Invalid option.")

main()
