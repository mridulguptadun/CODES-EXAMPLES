5. Calculate the difference between two time periods (hours, minutes, seconds).

c
#include <stdio.h>

struct Time {
    int hrs, mins, secs;
};

int main() {
    struct Time t1 = {5, 40, 20}, t2 = {2, 50, 35}, diff;
    if (t2.secs > t1.secs) {
        t1.mins--;
        t1.secs += 60;
    }
    diff.secs = t1.secs - t2.secs;
    if (t2.mins > t1.mins) {
        t1.hrs--;
        t1.mins += 60;
    }
    diff.mins = t1.mins - t2.mins;
    diff.hrs = t1.hrs - t2.hrs;

    printf("Difference = %02d:%02d:%02d\n", diff.hrs, diff.mins, diff.secs);
    return 0;
}
Use code with caution.

