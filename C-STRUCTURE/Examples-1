20. Pass an array of structures to a function to calculate total inventory value.

c
#include <stdio.h>

struct Product {
    int quantity;
    float price;
};

float totalValue(struct Product items[], int n) {
    float total = 0;
    for (int i = 0; i < n; i++) {
        total += items[i].quantity * items[i].price;
    }
    return total;
}

int main() {
    struct Product stock = {{10, 15.0}, {5, 40.0}, {2, 100.0}};
    printf("Total Inventory Value = %.2f\n", totalValue(stock, 3));
    return 0;
}
