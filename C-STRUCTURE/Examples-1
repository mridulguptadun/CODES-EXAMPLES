12. Sort an array of students in descending order based on marks.

c
#include <stdio.h>

struct Student {
    char name;
    float marks;
};

int main() {
    struct Student s = {{"A", 70}, {"B", 92}, {"C", 85}}, temp;
    for (int i = 0; i < 2; i++) {
        for (int j = 0; j < 2 - i; j++) {
            if (s[j].marks < s[j + 1].marks) {
                temp = s[j];
                s[j] = s[j + 1];
                s[j + 1] = temp;
            }
        }
    }
    for (int i = 0; i < 3; i++) printf("%s: %.1f\n", s[i].name, s[i].marks);
    return 0;
}
