3. Add two distances given in feet and inches using a structure.

c
#include <stdio.h>

struct Distance {
    int feet;
    float inches;
};

int main() {
    struct Distance d1 = {5, 8.5}, d2 = {4, 6.5}, sum;
    sum.feet = d1.feet + d2.feet;
    sum.inches = d1.inches + d2.inches;

    if (sum.inches >= 12.0) {
        sum.feet += (int)(sum.inches / 12);
        sum.inches = (int)sum.inches % 12 + (sum.inches - (int)sum.inches);
    }
    printf("Total Distance = %d feet %.1f inches\n", sum.feet, sum.inches);
    return 0;
}
Use code with caution.

