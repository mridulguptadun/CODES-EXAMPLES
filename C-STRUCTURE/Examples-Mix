9. Write a function that takes a Time structure (in seconds) and returns a normalized Time (hours, minutes, seconds).

#include <stdio.h>

struct Time {
    int hrs, mins, secs;
};

struct Time convertSeconds(int totalSeconds) {
    struct Time t;
    t.hrs = totalSeconds / 3600;
    t.mins = (totalSeconds % 3600) / 60;
    t.secs = totalSeconds % 60;
    return t;
}

int main() {
    struct Time t = convertSeconds(3665);
    printf("Time = %02d:%02d:%02d\n", t.hrs, t.mins, t.secs);
