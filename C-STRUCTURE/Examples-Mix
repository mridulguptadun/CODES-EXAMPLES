6. Write a function to multiply two Complex numbers and return the resulting structure.

#include <stdio.h>

struct Complex {
    int real, imag;
};

struct Complex multiplyComplex(struct Complex a, struct Complex b) {
    struct Complex res;
    res.real = (a.real * b.real) - (a.imag * b.imag);
    res.imag = (a.real * b.imag) + (a.imag * b.real);
    return res;
}

int main() {
    struct Complex c1 = {3, 2}, c2 = {1, 4};
    struct Complex prod = multiplyComplex(c1, c2);
    printf("Product = %d + %di\n", prod.real, prod.imag);
    return 0;
}
