25. Write a function to reduce a Fraction (numerator and denominator) to its simplest form.

#include <stdio.h>

struct Fraction {
    int num;
    int den;
};

int gcd(int a, int b) {
    return (b == 0) ? a : gcd(b, a % b);
}

struct Fraction simplify(struct Fraction f) {
    int common = gcd(f.num, f.den);
    f.num /= common;
    f.den /= common;
    return f;
}

int main() {
    struct Fraction f1 = {18, 24};
    f1 = simplify(f1);
    printf("Simplified Fraction: %d/%d\n", f1.num, f1.den);
    return 0;
}
