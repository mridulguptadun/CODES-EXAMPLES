16. Write a function to sort an array of Product structures by price in ascending order.

#include <stdio.h>

struct Product {
    char name[20];
    float price;
};

void sortByPrice(struct Product p[], int n) {
    for (int i = 0; i < n - 1; i++) {
        for (int j = 0; j < n - 1 - i; j++) {
            if (p[j].price > p[j + 1].price) {
                struct Product temp = p[j];
                p[j] = p[j + 1];
                p[j + 1] = temp;
            }
        }
    }
}

int main() {
    struct Product items[3] = {{"Mouse", 500}, {"Keyboard", 1200}, {"USB", 300}};
    sortByPrice(items, 3);
    for (int i = 0; i < 3; i++) printf("%s: %.2f\n", items[i].name, items[i].price);
    return 0;
}
