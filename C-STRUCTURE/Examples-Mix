23. Write a function to find the player with the highest strike rate (runs / balls) * 100.

#include <stdio.h>

struct Player {
    char name[20];
    int runs;
    int balls;
};

void bestStrikeRate(struct Player team[], int n) {
    int bestIdx = 0;
    float maxSR = (float)team[0].runs / team[0].balls * 100;
    for (int i = 1; i < n; i++) {
