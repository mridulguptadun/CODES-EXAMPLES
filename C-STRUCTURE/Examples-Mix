5. Write a function to compare two Date structures and return which one is earlier.

#include <stdio.h>

struct Date {
    int day, month, year;
};

struct Date getEarlierDate(struct Date d1, struct Date d2) {
    if (d1.year != d2.year) return (d1.year < d2.year) ? d1 : d2;
    if (d1.month != d2.month) return (d1.month < d2.month) ? d1 : d2;
    return (d1.day <= d2.day) ? d1 : d2;
}

int main() {
    struct Date d1 = {20, 5, 2026}, d2 = {10, 5, 2026};
    struct Date early = getEarlierDate(d1, d2);
    printf("Earlier Date: %02d/%02d/%d\n", early.day, early.month, early.year);
    return 0;
}
