def game_of_life(board):
    m, n = len(board), len(board[0])
    for r in range(m):
        for c in range(n):
            live = 0
            for dr in (-1, 0, 1):
                for dc in (-1, 0, 1):
                    if (dr or dc) and 0 <= r + dr < m and 0 <= c + dc < n:
                        live += board[r + dr][c + dc] & 1
            if (board[r][c] == 1 and live in (2, 3)) or (board[r][c] == 0 and live == 3):
                board[r][c] |= 2
    for r in range(m):
        for c in range(n):
            board[r][c] >>= 1
    return board

