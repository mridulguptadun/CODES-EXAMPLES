42. Word Search in Grid (Iterative Backtracking)
Check if a word exists in a 2D character grid via adjacent cells without reusing cells.
python
def word_exists(board, word):
    rows, cols = len(board), len(board[0])
    for r in range(rows):
        for c in range(cols):
            if board[r][c] == word[0]:
                stack = [(r, c, 0, {(r, c)})]
                while stack:
                    cr, cc, idx, visited = stack.pop()
                    if idx == len(word) - 1:
                        return True
                    for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):
                        nr, nc = cr + dr, cc + dc
                        if 0 <= nr < rows and 0 <= nc < cols and (nr, nc) not in visited:
                            if board[nr][nc] == word[idx + 1]:
                                stack.append((nr, nc, idx + 1, visited | {(nr, nc)}))
    return False

