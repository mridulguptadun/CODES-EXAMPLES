def longest_collatz(limit):
    cache = {1: 1}
    max_len, best_num = 0, 1
    for i in range(2, limit):
        curr, steps = i, 0
        while curr not in cache:
            curr = curr // 2 if curr % 2 == 0 else 3 * curr + 1
            steps += 1
        cache[i] = steps + cache[curr]
        if cache[i] > max_len:
            max_len, best_num = cache[i], i
    return best_num, max_len

