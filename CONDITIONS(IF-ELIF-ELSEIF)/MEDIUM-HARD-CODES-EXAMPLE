cores = int(input("Enter required CPU cores: "))
memory = int(input("Enter available memory in GB: "))
if priority == "high":
    if cores <= 8:
        print("High Priority Allocation Approved")
    elif cores > 8:
        if memory >= 32:
            print("Enterprise Allocation Approved")
        else:
            print("Rejected: Enterprise Memory Requirement Not Met")
elif priority == "medium":
    if cores <= 4:
        print("Medium Priority Allocation Approved")
    else:
        print("Upgrade to Enterprise Required")
elif priority == "low":
    if cores <= 2:
        print("Low Priority Allocation Approved")
    else:
        print("Resource Limit Exceeded")
else:
    print("Invalid Project Priority")
