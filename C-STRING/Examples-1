20. Write a function to remove duplicate characters from a string.

c
#include <stdio.h>

void removeDuplicates(char str[]) {
    int idx = 0;
    for (int i = 0; str[i] != '\0'; i++) {
        int seen = 0;
        for (int j = 0; j < idx; j++) {
            if (str[i] == str[j]) {
                seen = 1;
                break;
            }
        }
        if (!seen) {
            str[idx++] = str[i];
        }
    }
    str[idx] = '\0';
}

int main() {
    char str[] = "programming";
    removeDuplicates(str);
    printf("Without duplicates: %s\n", str);
    return 0;
}
Use code with caution.
