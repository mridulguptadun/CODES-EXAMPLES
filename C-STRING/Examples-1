15. Write a function to reverse a string in-place.

c
#include <stdio.h>
#include <string.h>

void reverseStr(char str[]) {
    int i = 0, j = strlen(str) - 1;
    while (i < j) {
        char temp = str[i];
        str[i] = str[j];
        str[j] = temp;
        i++;
        j--;
    }
}

int main() {
    char word[] = "abcdef";
    reverseStr(word);
    printf("Reversed: %s\n", word);
    return 0;
}
