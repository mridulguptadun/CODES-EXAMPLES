17. Write a function to check if two strings are anagrams of each other.

c
#include <stdio.h>
#include <string.h>

int areAnagrams(char s1[], char s2[]) {
    if (strlen(s1) != strlen(s2)) return 0;
    int freq = {0};
    for (int i = 0; s1[i] != '\0'; i++) {
        freq[(unsigned char)s1[i]]++;
        freq[(unsigned char)s2[i]]--;
    }
    for (int i = 0; i < 256; i++) {
        if (freq[i] != 0) return 0;
    }
    return 1;
}

int main() {
    printf(areAnagrams("listen", "silent") ? "Anagrams\n" : "Not Anagrams\n");
    return 0;
}
