19. Write a function to check if a string starts with a given prefix.

#include <stdio.h>
#include <string.h>

int startsWith(char str[], char prefix[]) {
    int len = strlen(prefix);
    for (int i = 0; i < len; i++) {
        if (str[i] != prefix[i]) return 0;
    }
    return 1;
}

int main() {
    printf(startsWith("unhappy", "un") ? "Yes, starts with 'un'\n" : "No\n");
    return 0;
}
