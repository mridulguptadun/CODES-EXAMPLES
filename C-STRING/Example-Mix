14. Write a function to copy a string into another array.

#include <stdio.h>

void copyString(char dest[], char src[]) {
    int i = 0;
    while (src[i] != '\0') {
        dest[i] = src[i];
        i++;
    }
    dest[i] = '\0';
}

int main() {
    char a[] = "Learn C", b[50];
    copyString(b, a);
    printf("Copied: %s\n", b);
    return 0;
}
