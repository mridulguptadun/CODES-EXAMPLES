15. Write a function to join (concatenate) two strings into a destination array.

#include <stdio.h>

void joinStrings(char s1[], char s2[]) {
    int i = 0, j = 0;
    while (s1[i] != '\0') i++;
    while (s2[j] != '\0') {
        s1[i++] = s2[j++];
    }
    s1[i] = '\0';
}

int main() {
    char first[50] = "Hello ", second[] = "World!";
    joinStrings(first, second);
    printf("Joined: %s\n", first);
    return 0;
}
