18. Write a function to extract and print the initials of a full name.

#include <stdio.h>

void printInitials(char name[]) {
    if (name[0] != ' ') printf("%c.", name[0]);
    for (int i = 1; name[i] != '\0'; i++) {
        if (name[i - 1] == ' ' && name[i] != ' ') {
            printf("%c.", name[i]);
        }
    }
    printf("\n");
}

int main() {
    char fullName[] = "Rahul Kumar Sharma";
    printInitials(fullName);
    return 0;
}
