1. Write a function to return the length of a string (without <string.h>).

#include <stdio.h>

int getLength(char str[]) {
    int count = 0;
    while (str[count] != '\0') count++;
    return count;
}

int main() {
    char word[] = "Dehradun";
    printf("Length = %d\n", getLength(word));
    return 0;
}
