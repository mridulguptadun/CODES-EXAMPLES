7. Write a function to check if a string is a palindrome.

#include <stdio.h>
#include <string.h>

int isPalindrome(char str[]) {
    int left = 0, right = strlen(str) - 1;
    while (left < right) {
        if (str[left] != str[right]) return 0;
        left++;
        right--;
    }
    return 1;
}

int main() {
    char word[] = "level";
    printf(isPalindrome(word) ? "Palindrome\n" : "Not Palindrome\n");
    return 0;
}
