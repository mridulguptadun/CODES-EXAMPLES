10. Write a function to find the index of the last occurrence of a character in a string.

#include <stdio.h>

int lastIndexOf(char str[], char target) {
    int lastIdx = -1;
    for (int i = 0; str[i] != '\0'; i++) {
        if (str[i] == target) lastIdx = i;
    }
    return lastIdx;
}

int main() {
    char text[] = "banana";
    printf("Last index of 'a' = %d\n", lastIndexOf(text, 'a'));
    return 0;
}
