8. Inventory Stock Management
Write a program that accepts product quantities and updates stock. Handle requests exceeding available stock.

stock = {"laptop": 10,    "mobile": 20,    "tablet": 5}
try:    
product = input("Enter product: ").lower()    
quantity = int(input("Enter quantity: "))    
if quantity <= 0:        
raise ValueError("Invalid quantity")    
if product not in stock:        
raise KeyError("Product not found")    
if quantity > stock[product]:        
raise OverflowError("Insufficient stock")    
stock[product] -= quantity    
print("Order successful!")    
