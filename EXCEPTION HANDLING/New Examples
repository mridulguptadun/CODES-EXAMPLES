24. Sports Tournament Score Validation
Accept scores of five players, skip invalid scores, and calculate the highest valid score. Reject scores outside 0–100.

scores = ["85", "92", "abc", "110", "76", "95"]
valid_scores = []
for score in scores:    
try:        
value = int(score)        
if value < 0 or value > 100:            
raise ValueError("Score out of range")        
valid_scores.append(value)    
except ValueError as e:        
print("Invalid score:", score, "-", e)
try:    
if not valid_scores:       
raise LookupError("No valid scores found")    
print("Highest Score:", max(valid_scores))    
print("Average Score:", sum(valid_scores) / len(valid_scores))
except LookupError as e:    
print("Error:", e)
====================================================================

25. Online Payment Gateway
Create a payment validation program that checks payment amount, payment method, and available balance. Handle different types of errors separately.

balance = 5000
methods = ["UPI", "CARD", "NETBANKING"]
try:    
amount = float(input("Enter payment amount: "))    
method = input("Payment method: ").upper()    
if amount <= 0:        
raise ValueError("Invalid payment amount")    
if method not in methods:        
raise LookupError("Unsupported payment method")    
if amount > balance:        
raise ArithmeticError("Insufficient balance")    
balance -= amount    
print("Payment successful!")    
print("Payment method:", method)    
print("Remaining balance:", balance)
except ValueError as e:    
print("Amount Error:", e)
except LookupError as e:    
print("Method Error:", e)
except ArithmeticError as e:    
print("Payment Error:", e)
finally:    
print("Payment processing completed.")

