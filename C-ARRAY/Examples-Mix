11. Reverse an array in-place (modifying the original array).

#include <stdio.h>
int main() {
    int arr[5] = {10, 20, 30, 40, 50};
    int start = 0, end = 4, temp;
    while (start < end) {
        temp = arr[start];
        arr[start] = arr[end];
        arr[end] = temp;
        start++;
        end--;
    }
    printf("Reversed array: ");
    for (int i = 0; i < 5; i++) printf("%d ", arr[i]);
    return 0;
}
