22. Multiply two 2x2 matrices.

#include <stdio.h>
int main() {
    int a[2][2] = {{1, 2}, {3, 4}}, b[2][2] = {{2, 0}, {1, 2}}, prod[2][2] = {0};
    for (int i = 0; i < 2; i++) {
        for (int j = 0; j < 2; j++) {
            for (int k = 0; k < 2; k++) {
                prod[i][j] += a[i][k] * b[k][j];
            }
            printf("%d ", prod[i][j]);
        }
        printf("\n");
    }
    return 0;
}
