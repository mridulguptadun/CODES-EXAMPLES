13. Sort an array in ascending order using Bubble Sort.

#include <stdio.h>
int main() {
    int arr[5] = {64, 34, 25, 12, 22}, temp;
    for (int i = 0; i < 4; i++) {
        for (int j = 0; j < 4 - i; j++) {
            if (arr[j] > arr[j + 1]) {
                temp = arr[j];
                arr[j] = arr[j + 1];
                arr[j + 1] = temp;
            }
        }
    }
    printf("Sorted array: ");
    for (int i = 0; i < 5; i++) printf("%d ", arr[i]);
    return 0;
}
