25. Calculate the sum of each row and each column of a 2x2 matrix.

#include <stdio.h>
int main() {
    int mat[2][2] = {{10, 20}, {30, 40}};
    for (int i = 0; i < 2; i++) {
        int rowSum = 0, colSum = 0;
        for (int j = 0; j < 2; j++) {
            rowSum += mat[i][j];
            colSum += mat[j][i];
        }
        printf("Row %d sum = %d, Column %d sum = %d\n", i + 1, rowSum, i + 1, colSum);
    }
    return 0;
}
