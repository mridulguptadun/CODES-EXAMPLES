7. Write a function to perform Binary Search on a sorted array.

c
#include <stdio.h>

int binarySearch(int arr[], int n, int target) {
    int left = 0, right = n - 1;
    while (left <= right) {
        int mid = left + (right - left) / 2;
        if (arr[mid] == target) return mid;
        if (arr[mid] < target) left = mid + 1;
        else right = mid - 1;
    }
    return -1;
}

int main() {
    int arr[] = {11, 22, 33, 44, 55};
    printf("Found at index: %d\n", binarySearch(arr, 5, 44));
    return 0;
}
Use code with caution.

8. Write a function to count how many prime numbers exist in an array.

c
#include <stdio.h>

int isPrime(int num) {
    if (num <= 1) return 0;
    for (int i = 2; i * i <= num; i++) {
        if (num % i == 0) return 0;
    }
    return 1;
}

int countPrimes(int arr[], int n) {
    int count = 0;
    for (int i = 0; i < n; i++) {
        if (isPrime(arr[i])) count++;
    }
    return count;
}

int main() {
    int arr[] = {2, 4, 5, 8, 11, 15};
    printf("Prime count = %d\n", countPrimes(arr, 6));
    return 0;
}
