25. Write a recursive function to find the maximum element in an array.

c
#include <stdio.h>

int recursiveMax(int arr[], int n) {
    if (n == 1) return arr[0];
    int maxRest = recursiveMax(arr, n - 1);
    return (arr[n - 1] > maxRest) ? arr[n - 1] : maxRest;
}

int main() {
    int arr[] = {15, 42, 8, 93, 27};
    printf("Recursive Max = %d\n", recursiveMax(arr, 5));
    return 0;
}
